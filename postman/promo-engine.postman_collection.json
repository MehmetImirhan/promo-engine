        {
          "name": "Create ingest job (upload CSV)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"202 created or 200 deduplicated\", () => pm.expect([200, 202]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.test(\"job id and created flag\", () => { pm.expect(body.id).to.be.a(\"string\"); pm.expect(body.created).to.eql(pm.response.code === 202); });",
                  "pm.collectionVariables.set(\"jobId\", body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "vendor_id",
                  "value": "acme",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "data/vendor.csv",
