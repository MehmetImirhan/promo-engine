    {
      "name": "Products",
      "item": [
        {
          "name": "List products (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has items and a cursor\", () => { pm.expect(body.items).to.be.an(\"array\").that.is.not.empty; pm.expect(body).to.have.property(\"next_cursor\"); });",
                  "pm.test(\"sorted by effective_price ascending\", () => {",
                  "  const prices = body.items.map((p) => p.effective_price);",
                  "  for (let i = 1; i < prices.length; i++) pm.expect(Number(prices[i]) >= Number(prices[i - 1])).to.be.true;",
                  "});",
                  "pm.collectionVariables.set(\"categoryId\", body.items[0].category_id);",
                  "pm.collectionVariables.set(\"productId\", body.items[0].id);",
                  "if (body.next_cursor) pm.collectionVariables.set(\"cursor\", body.next_cursor);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?order=asc&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "order",
                  "value": "asc",
                  "description": "asc | desc by effective_price"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "1–100, default 20"
                },
                {
                  "key": "category_id",
                  "value": "{{categoryId}}",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Sorted by `effective_price` in SQL, keyset-paginated. Seeds `categoryId`, `productId` and `cursor` for the requests that follow."
          },
          "response": []
        },
