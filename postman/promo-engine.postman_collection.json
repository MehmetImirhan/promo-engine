    {
      "name": "Promotions",
      "description": "Exactly one scope per promotion (`product_id` XOR `category_id`). Overlap within a scope is refused by the database EXCLUDE constraints (409). Cross-scope conflicts resolve by precedence: product scope wins.",
      "item": [
        {
          "name": "Create product promotion (15 %)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Fresh window on every run: starts now, ends in 7 days.",
                  "const now = new Date();",
                  "pm.collectionVariables.set(\"startsAt\", now.toISOString());",
                  "pm.collectionVariables.set(\"endsAt\", new Date(now.getTime() + 7 * 24 * 3600 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const promo = pm.response.json();",
                  "pm.test(\"active product-scope promotion\", () => { pm.expect(promo.status).to.eql(\"ACTIVE\"); pm.expect(promo.product_id).to.eql(pm.collectionVariables.get(\"productId\")); });",
                  "pm.collectionVariables.set(\"promotionId\", promo.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman 15% off product A\",\n  \"product_id\": \"{{productId}}\",\n  \"discount_type\": \"PERCENTAGE\",\n  \"value\": \"15\",\n  \"starts_at\": \"{{startsAt}}\",\n  \"ends_at\": \"{{endsAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "promotions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create overlapping product promotion → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code CONFLICT\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql(\"CONFLICT\");",
                  "  pm.expect(body.requestId).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"structured constraint details\", () => { const d = pm.response.json().error.details; pm.expect(d.scope).to.eql(\"product\"); pm.expect(d.constraint).to.be.a(\"string\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman overlapping promo\",\n  \"product_id\": \"{{productId}}\",\n  \"discount_type\": \"PERCENTAGE\",\n  \"value\": \"10\",\n  \"starts_at\": \"{{startsAt}}\",\n  \"ends_at\": \"{{endsAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "promotions"
              ]
            },
            "description": "Same product, same window. Refused by `no_overlapping_product_promos` (SQLSTATE 23P01 → 409)."
          },
          "response": []
        },
        {
          "name": "Get product A (discounted)",
          "event": [
            {
              "listen": "test",
