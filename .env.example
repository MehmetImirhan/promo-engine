# Copy to .env to override. Every value below is also the built-in default,
# so `docker compose up -d && npm run migrate && npm run dev` works without a .env.

# --- docker-compose (host ports + Postgres bootstrap) ---
POSTGRES_PORT=5432
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promo
REDIS_PORT=6379

# --- application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://promo:promo@localhost:5432/promo
REDIS_URL=redis://localhost:6379

# --- ingest pipeline ---
# Local Storage root (uploads/, chunks/ and measure/ live under it). S3 in production.
STORAGE_DIR=./data
# Rows per chunk: the memory unit of one splitter/processor invocation (max 10000).
INGEST_CHUNK_SIZE=1000
# Concurrent chunk invocations per worker process.
INGEST_WORKER_CONCURRENCY=4
# Queue delivery attempts per chunk before it is parked in the DLQ.
INGEST_MAX_ATTEMPTS=3
# Simulated function timeout for the worker's remainingTimeMs(); also the
# age after which a chunk stuck in PROCESSING may be reclaimed.
INGEST_INVOCATION_TIMEOUT_MS=60000
# The splitter re-enqueues itself when less than this much time remains.
INGEST_SPLIT_RESERVE_MS=2000

# --- caching ---
# Kill switch for the Redis cache-aside layer (reads go straight to Postgres when false).
CACHE_ENABLED=true
# Coalesce concurrent misses for the same key into one query. Off only for the ADR §6 comparison run.
CACHE_SINGLE_FLIGHT=true

# --- tests ---
# Integration tests create this database if missing, migrate it, and
# TRUNCATE its tables before every run. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://promo:promo@localhost:5432/promo_test
# Integration tests FLUSHDB this logical database before every run. Must differ from REDIS_URL.
TEST_REDIS_URL=redis://localhost:6379/1
