{
  "name": "promo-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Promotion Management API",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx src/worker.ts",
    "ingest:generate": "tsx scripts/ingest/generate.ts",
    "ingest:measure": "bash scripts/ingest/measure.sh",
    "load": "tsx scripts/load/run.ts",
    "ui": "node ui/server.mjs"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "busboy": "^1.6.0",
    "csv-parse": "^5.6.0",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
